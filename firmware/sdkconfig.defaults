CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000

# PSRAM holds the frame buffer, album art and TLS buffers.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
# Keep internal SRAM for Wi-Fi, DMA and task stacks; LVGL objects and glyphs go to PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152

# Web socket server for the PC companion.
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# HTTPS for Open-Meteo.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y

# LVGL 9
CONFIG_LV_COLOR_DEPTH_16=y
# LVGL objects live in PSRAM (lv_mem_psram.c): plain malloc put every object
# under 512 bytes in internal RAM, which ran out as pages were added.
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_MEM_MONITOR=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_USE_DEMO_WIDGETS=n
CONFIG_LV_USE_DEMO_BENCHMARK=n
CONFIG_LV_USE_DEMO_MUSIC=n
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# Rendering speed: -O2 instead of the debug default.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# Not used, measured: two LVGL draw threads (CONFIG_LV_OS_FREERTOS + LV_DRAW_SW_DRAW_UNIT_CNT=2)
# cut a full redraw only 13% but cost ~33 KB of internal RAM; LV_ATTRIBUTE_FAST_MEM_USE_IRAM
# used up internal RAM entirely.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desk Hub",
  "version": "0.2.1",
  "identifier": "org.xoudusz.deskhub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Desk Hub",
        "width": 820,
        "height": 620,
        "minWidth": 640,
        "minHeight": 440,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Xoudusz",
    "shortDescription": "Companion app for the Desk Hub board",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } },
    "externalBin": ["binaries/deskhub-cli"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFMzU4QTg4OEFBMzczQTEKUldTaGM2T0tpSW8xYm8zSm5VVWdKTE44VGp1eFF3dDVxckcwbjNhNHdlcXV0bjZGc2o4OVVDUTUK",
      "endpoints": ["https://github.com/Xoudusz/deskhub/releases/download/desktop-latest/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
